{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@remotex/shared/*": ["shared/*"],
      "@remotex/auth/*": ["authentication/*"],
      "@remotex/security/*": ["security/*"],
      "@remotex/input/*": ["remote-input/*"],
      "@remotex/media/*": ["media-engine/*"],
      "@remotex/capture/*": ["screen-capture/*"],
      "@remotex/audio/*": ["audio/*"],
      "@remotex/recording/*": ["recording/*"],
      "@remotex/admin/*": ["admin/*"],
      "@remotex/devices/*": ["device-management/*"],
      "@remotex/signaling/*": ["signaling-server/*"],
      "@remotex/database/*": ["database/*"]
    }
  }
}
